# Server
RUN_PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost
TRUST_PROXY=true

# MongoDB - Get from https://cloud.mongodb.com/
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# JWT - IMPORTANT: Change this to a long random string in production!
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_characters
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=jwt
JWT_COOKIE_MAX_AGE_MS=604800000
COOKIE_DOMAIN=

# Rate Limiting - Get from https://app.arcjet.com/
ARCJET_KEY=your_arcjet_key_here
ARCJET_ENV=development

# Image Upload - Get from https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Limits
MAX_JSON_SIZE=2mb
MAX_URL_ENCODED_SIZE=1mb
MAX_IMAGE_UPLOAD_BYTES=5242880
REQUEST_TIMEOUT_MS=15000
LOG_LEVEL=info

# HTTPS/TLS (Production)
APP_DOMAIN=your-domain.com
TLS_EMAIL=your-email@example.com

# Microservices (Optional)
CHAT_SAFETY_SERVICE_URL=http://chat-safety-service:8000
CHAT_ANALYTICS_SERVICE_URL=http://chat-analytics-service:8001
